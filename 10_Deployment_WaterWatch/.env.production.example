# ==============================================================================
# WATERWATCH V3 SECURE — PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# CATATAN KEAMANAN:
# JANGAN PERNAH menyimpan kredensial asli (password, token, secret) ke git repository.
# Masukkan nilai variabel di bawah ini ke menu Project Settings -> Environment Variables di Vercel Dashboard.
# ==============================================================================

# 1. DATABASE POSTGRESQL TERKELOLA (NEON ATAU SUPABASE)
# Gunakan connection pooling dan mode SSL wajib (sslmode=require).
#
# Contoh format Neon Serverless:
# DATABASE_URL="postgresql://waterwatch_owner:AbCdEf123456@ep-cool-fog-123456-pooler.us-east-2.aws.neon.tech/waterwatch?sslmode=require"
#
# Contoh format Supabase (Port 6543 untuk Transaction Connection Pooler):
# DATABASE_URL="postgresql://postgres.yourprojectref:YourStrongPassword123@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require"
DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require"

# 2. AUTENTIKASI DAN KEAMANAN JWT
# Buat string acak berkekuatan tinggi (minimal 64 karakter).
# Generate menggunakan terminal: openssl rand -base64 48
JWT_SECRET="YOUR_STRONG_RANDOM_JWT_SECRET_KEY_MINIMUM_64_CHARACTERS"

# Durasi masa aktif sesi token dalam satuan menit (480 menit = 8 jam sesuai shift operator)
JWT_EXPIRATION_MINUTES=480

# 3. PERLINDUNGAN BRUTE FORCE (ACCOUNT LOCKOUT)
# Jumlah maksimal kesalahan kata sandi sebelum akun dikunci otomatis
LOGIN_MAX_ATTEMPTS=5

# Durasi penguncian akun sementara dalam satuan menit
LOGIN_LOCK_MINUTES=15

# 4. KONEKTIVITAS API & FRONTEND
# Default: '/api' (menggunakan Next.js Route Handlers terintegrasi pada origin yang sama)
# Jika menggunakan Backend Rust terpisah: ganti dengan URL deployment backend Rust, misal:
# NEXT_PUBLIC_API_BASE_URL="https://waterwatch-backend-production.up.railway.app/api"
NEXT_PUBLIC_API_BASE_URL="/api"

# Nama aplikasi publik
NEXT_PUBLIC_APP_NAME="WaterWatch — CCTV Analitik Keamanan Kota"

# 5. KHUSUS BACKEND RUST AXUM (Jika dideploy pada Railway / Render / Fly.io)
# Port yang akan digunakan server HTTP (biasanya otomatis disetel oleh PaaS melalui $PORT)
PORT=8080

# Domain Frontend yang diizinkan untuk Cross-Origin Resource Sharing (CORS)
# Pisahkan dengan tanda koma jika memiliki multiple domain (misal Vercel preview & production)
FRONTEND_ORIGIN="https://waterwatch-v3.vercel.app,https://*.vercel.app"

# Simulator deteksi event berkala (true/false)
EVENT_SIMULATOR_ENABLED=true
EVENT_SIMULATOR_INTERVAL_SECONDS=30
EVENT_CONFIDENCE_THRESHOLD=0.60

