# ========================================================
# WaterWatch — CCTV Analitik Keamanan Kota
# Master Environment Configuration Template
# ========================================================

# Database PostgreSQL Connection (Neon, Supabase, or Local PostgreSQL)
DATABASE_URL=postgres://openpg:openpgpwd@127.0.0.1:5432/waterwatch

# JWT Authentication
JWT_SECRET=waterwatch-super-secret-jwt-key-2026-cctv-secure-dev
JWT_EXPIRATION_MINUTES=480

# Backend Server Configuration (Rust Axum)
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Security & Brute-Force Lockout
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Event Detection Simulator
EVENT_SIMULATOR_ENABLED=true
EVENT_SIMULATOR_INTERVAL_SECONDS=30
EVENT_CONFIDENCE_THRESHOLD=0.60

# Frontend Next.js Public Config
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_APP_NAME="WaterWatch — CCTV Analitik Keamanan Kota"

